# systemd *user* service (runs as you, so it can see your games and send desktop notifications)
# install.sh writes and enables this for you. By hand:
# cp padlink.service ~/.config/systemd/user/ && systemctl --user enable --now padlink
[Unit]
Description=padlink - DualSense/DS4 profiles, triggers and battery monitor
After=graphical-session.target

[Service]
ExecStart=%h/.local/bin/padlink daemon -v
ExecStopPost=-/usr/bin/sudo -n /usr/local/libexec/padlink-hide show-all
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
